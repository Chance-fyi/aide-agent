# ============================================================
# 三、易混淆（相邻政策的数字/责任方不同）
# 退货 7 天 vs 换货 15 天；退货邮费 vs 换货运费；保修期 vs 退货期
# 这类题考的是"检索是否抓对文件"——抓错了 LLM 会一本正经答错
# ============================================================
{"id": "conf-1", "category": "易混淆", "question": "质量问题想换一个新的，超过一周了还能换吗？", "expect_sources": ["exchange.md"], "expect_any": ["15天"], "expect_transfer": false}
{"id": "conf-2", "category": "易混淆", "question": "无理由退货是几天内？", "expect_sources": ["returns.md"], "expect_any": ["7天"], "expect_transfer": false}
{"id": "conf-3", "category": "易混淆", "question": "质量问题换货，我寄过去的运费能报销吗？", "expect_sources": ["exchange.md"], "expect_any": ["商家承担", "返还", "垫付"], "expect_transfer": false}
{"id": "conf-4", "category": "易混淆", "question": "数码家电的保修期是多久？", "expect_sources": ["warranty.md"], "expect_any": ["1年"], "expect_transfer": false}
{"id": "conf-5", "category": "易混淆", "question": "待发货的订单能取消吗？取消后钱怎么退？", "expect_sources": ["faq.md", "refund.md"], "expect_any": ["1-3", "1~3", "1至3"], "expect_transfer": false}

# ============================================================
# 四、多跳（一条回答需要综合两个文件）
# 单文件召回不够用：只命中其中一个就会答半截
# ============================================================
{"id": "multi-1", "category": "多跳", "question": "退货寄回去以后，钱多久能退到我的银行卡里？", "expect_sources": ["returns.md", "refund.md"], "expect_any": ["3-7", "3~7", "3至7", "3到7"], "expect_transfer": false}
{"id": "multi-2", "category": "多跳", "question": "用了优惠券的订单退货了，券会还给我吗？钱怎么退？", "expect_sources": ["coupons.md"], "expect_any": ["返还", "有效期"], "expect_transfer": false}
{"id": "multi-3", "category": "多跳", "question": "换货的商品你们收到后多久能发新的？", "expect_sources": ["exchange.md"], "expect_any": ["3个工作日", "3 个工作日"], "expect_transfer": false}

# ============================================================
# 五、多轮指代（history 里给出前文，question 带指代词）
# 检索用 retrieval_query（改写后的意图）来校验，这是 query 改写的目标上限
# ============================================================
{"id": "ctx-1", "category": "多轮指代", "history": ["我想退货"], "question": "多久之内可以？", "retrieval_query": "退货多久之内可以申请", "expect_sources": ["returns.md"], "expect_any": ["7天"], "expect_transfer": false}
{"id": "ctx-2", "category": "多轮指代", "history": ["我的订单还没发货"], "question": "那能直接退钱吗？", "retrieval_query": "未发货订单可以仅退款吗", "expect_sources": ["refund.md"], "expect_any": ["未发货", "仅退款"], "expect_transfer": false}
{"id": "ctx-3", "category": "多轮指代", "history": ["我是金卡会员"], "question": "那我买东西打几折？", "retrieval_query": "金卡会员享受什么折扣", "expect_sources": ["membership.md"], "expect_any": ["92"], "expect_transfer": false}
{"id": "ctx-4", "category": "多轮指代", "history": ["刚买的手机坏了"], "question": "那修要花钱吗？", "retrieval_query": "手机保修期内维修是否收费", "expect_sources": ["warranty.md"], "expect_any": ["免费", "保修范围"], "expect_transfer": false}

