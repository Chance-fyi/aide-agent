# ============================================================
# 二、同义改写（用户真实说法，不含知识库原词）
# 考的是 embedding 泛化能力：说法越口语，纯向量检索越容易漏
# ============================================================
{"id": "para-1", "category": "同义改写", "question": "东西到手了发现不合心意，多久之内能反悔？", "expect_sources": ["returns.md"], "expect_any": ["7天"], "expect_transfer": false}
{"id": "para-2", "category": "同义改写", "question": "包装拆了还能不能退？", "expect_sources": ["returns.md"], "expect_any": ["未使用", "不影响二次销售"], "expect_transfer": false}
{"id": "para-3", "category": "同义改写", "question": "我不想要了寄回去的邮费是我出还是你们出？", "expect_sources": ["returns.md"], "expect_any": ["买家", "自行承担"], "expect_transfer": false}
