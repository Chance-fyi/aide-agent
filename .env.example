# ============================================================
# LLM 配置（OpenAI 兼容接口，任何厂商只需改这三个值）
# 示例：
#   硅基流动: https://api.siliconflow.cn/v1  +  deepseek-ai/DeepSeek-V3
#   DeepSeek: https://api.deepseek.com/v1   +  deepseek-chat
#   Ollama:   http://localhost:11434/v1     +  qwen2.5:7b
# ============================================================
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# ============================================================
# Embedding（本地 BGE 模型，无需 Key）
# ============================================================
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5

# ============================================================
# Postgres（会话记忆 Checkpointer + 业务数据）
# ============================================================
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=aide
POSTGRES_PASSWORD=aide_secret
POSTGRES_DB=aide_agent

# ============================================================
# Milvus（向量数据库）
# ============================================================
MILVUS_URI=http://localhost:19530

# ============================================================
# 业务配置
# ============================================================
# 单轮对话最多携带的历史轮数（超出由 Checkpointer 状态管理截断）
HISTORY_MAX_ROUNDS=10
# RAG 检索返回条数
RETRIEVAL_TOP_K=3
# 强制转人工的关键词（逗号分隔）
TRANSFER_KEYWORDS=转人工,人工客服,投诉,退款电话,12315
