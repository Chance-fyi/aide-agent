# ============================================================
# LLM 配置（OpenAI 兼容接口，任何厂商只需改这三个值）
# 示例：
#   硅基流动: https://api.siliconflow.cn/v1  +  deepseek-ai/DeepSeek-V3
#   DeepSeek: https://api.deepseek.com/v1   +  deepseek-chat
#   Ollama:   http://localhost:11434/v1     +  qwen2.5:7b
# ============================================================
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# ============================================================
# Embedding（本地 BGE 模型，无需 Key）
# ============================================================
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5

# ============================================================
# Postgres（会话记忆 Checkpointer + 业务数据）
# ============================================================
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=aide
POSTGRES_PASSWORD=aide_secret
POSTGRES_DB=aide_agent

# ============================================================
# Milvus（向量数据库）
# ============================================================
MILVUS_URI=http://localhost:19530
# 知识库检索别名（指向当前线上版本集合）
KB_ALIAS=kb_chunks
# 集合 schema 版本：切分逻辑/表结构变化时 +1，触发新版本集合重建
KB_SCHEMA_VERSION=1
# embedding 向量维度：换 embedding 模型时必须同步改
# bge-small-zh-v1.5=512 / bge-base-zh-v1.5=768 / bge-m3=1024
EMBEDDING_DIM=512
# 蓝绿重建冒烟测试查询（逗号分隔，新数据必须命中才上线）
REBUILD_SMOKE_QUERIES=退货,退款,发货
# 知识库切分策略：header（按标题，结构化文档首选）/ paragraph（按段落聚合）/ fixed（固定窗口）
# 切换后需 bump KB_SCHEMA_VERSION 再重建（可用 /debug/kb/split_compare 先对比效果）
KB_SPLIT_STRATEGY=header

# ============================================================
# 业务配置
# ============================================================
# 送给 LLM 的上下文窗口：最多携带最近多少轮对话（一轮 = 用户提问 + 回复）
# 不裁剪的话 token 成本随会话长度线性上涨，最终撞上模型上下文上限。
# 只影响“送给模型的窗口”，Checkpointer 完整历史保留。<=0 表示不限制（仅调试）
HISTORY_MAX_ROUNDS=10
# 上下文压缩："已滑出窗口但还没压过"的轮数达到该值时，
# 调一次 LLM 把它们压成摘要并拼进系统提示。<=0 表示关闭压缩（只裁剪不压缩）
SUMMARY_TRIGGER_ROUNDS=5
# 摘要长度上限（字）：摘要本身也不能无限增长
SUMMARY_MAX_CHARS=600
# RAG 检索返回条数
RETRIEVAL_TOP_K=3
# 检索相似度阈值：低于此分数的命中丢弃（防幻觉；调 0 可查看全量分数）
RETRIEVAL_MIN_SCORE=0.4
# 强制转人工的关键词（逗号分隔）
TRANSFER_KEYWORDS=转人工,人工客服,投诉,退款电话,12315

# 输入防护：注入检测 + 违禁词（生产务必开启）
INPUT_GUARDRAIL=true
# 违禁词追加表（逗号分隔，与内置默认表叠加）
BLOCKED_WORDS=

# 调试接口开关（/debug/kb/* 仅在 true 时注册，生产环境务必关闭）
DEBUG=true

# 登录认证：Token 签名密钥（生产必须改为随机长字符串，如 openssl rand -hex 32）
AUTH_SECRET=dev-secret-change-me
