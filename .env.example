# ============================================================
# LLM 配置（OpenAI 兼容接口，任何厂商只需改这三个值）
# 示例：
#   硅基流动: https://api.siliconflow.cn/v1  +  deepseek-ai/DeepSeek-V3
#   DeepSeek: https://api.deepseek.com/v1   +  deepseek-chat
#   Ollama:   http://localhost:11434/v1     +  qwen2.5:7b
# ============================================================
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# ============================================================
# Embedding（本地 BGE 模型，无需 Key）
# ============================================================
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5

# ============================================================
# Postgres（会话记忆 Checkpointer + 业务数据）
# ============================================================
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=aide
POSTGRES_PASSWORD=aide_secret
POSTGRES_DB=aide_agent

# ============================================================
# Milvus（向量数据库）
# ============================================================
MILVUS_URI=http://localhost:19530
# 知识库检索别名（指向当前线上版本集合）
KB_ALIAS=kb_chunks
# 集合 schema 版本：切分逻辑/表结构变化时 +1，触发新版本集合重建
KB_SCHEMA_VERSION=1
# embedding 向量维度：换 embedding 模型时必须同步改
# bge-small-zh-v1.5=512 / bge-base-zh-v1.5=768 / bge-m3=1024
EMBEDDING_DIM=512
# 蓝绿重建冒烟测试查询（逗号分隔，新数据必须命中才上线）
REBUILD_SMOKE_QUERIES=退货,退款,发货
# 知识库切分策略：header（按标题，结构化文档首选）/ paragraph（按段落聚合）/ fixed（固定窗口）
# 切换后需 bump KB_SCHEMA_VERSION 再重建（可用 /debug/kb/split_compare 先对比效果）
KB_SPLIT_STRATEGY=header

# ============================================================
# 业务配置
# ============================================================
# 送给 LLM 的上下文窗口目标轮数（一轮 = 用户提问 + 回复）
# 窗口锚定压缩水位线（不滑动），实际在 N ~ N+SUMMARY_TRIGGER_ROUNDS 之间摆动。
# 为什么不用滑动窗口：滑动会让每轮请求整体左移，前缀缓存全部失效
HISTORY_MAX_ROUNDS=10
# 窗口涨到 HISTORY_MAX_ROUNDS + 本值 时压缩一次，窗口重置回目标大小。
# 本值也决定"多久重置一次窗口"——重置越频繁，前缀缓存失效越频繁。
# <=0 表示关闭压缩（此时不再裁剪，等价于全量发送）
SUMMARY_TRIGGER_ROUNDS=5
# 摘要长度上限（字）：摘要本身也不能无限增长
SUMMARY_MAX_CHARS=600
# RAG 检索返回条数
RETRIEVAL_TOP_K=3
# 检索相似度阈值：低于此分数的命中丢弃（防幻觉；调 0 可查看全量分数）
RETRIEVAL_MIN_SCORE=0.4
# 强制转人工的关键词（逗号分隔）
TRANSFER_KEYWORDS=转人工,人工客服,投诉,退款电话,12315

# 输入防护：注入检测 + 违禁词（生产务必开启）
INPUT_GUARDRAIL=true
# 违禁词追加表（逗号分隔，与内置默认表叠加）
BLOCKED_WORDS=

# 调试接口开关（/debug/kb/* 仅在 true 时注册，生产环境务必关闭）
DEBUG=true

# 登录认证：Token 签名密钥（生产必须改为随机长字符串，如 openssl rand -hex 32）
AUTH_SECRET=dev-secret-change-me

# ============================================================
# Langfuse 可观测性（可选，不配则完全 no-op）
# 两个 Key 都填了才会接入
#
# 自建（推荐本地开发，已在 compose.yaml 的 observability profile 里预置）：
#   podman compose --profile observability up -d
#   LANGFUSE_HOST=http://localhost:3000
#   LANGFUSE_PUBLIC_KEY=pk-lf-aide-agent-dev
#   LANGFUSE_SECRET_KEY=sk-lf-aide-agent-dev
#   UI: http://localhost:3000 （dev@aide-agent.local / dev-password-123）
#
# 用云端则把 HOST 改回 https://cloud.langfuse.com 并填自己的 Key
# ============================================================
LANGFUSE_ENABLED=true
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://localhost:3000
# 环境标签：同一套 Key 下区分 dev/staging/prod，便于在 UI 里筛选
LANGFUSE_ENVIRONMENT=development
